{
  "schemaVersion": 1,
  "id": "highlightblock",
  "version": "${version}",
  "name": "Highlight Block",
  "description": "Easily spotlight and highlight any block in the world with bright colors and full visibility without X-Ray or wallhacks.",
  "authors": [
    "Richard",
    "Wintercraft Community"
  ],
  "contact": {
    "homepage": "https://wintercraft.community"
  },
  "license": "MIT",
  "icon": "assets/highlightblock/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "community.wintercraft.highlightblock.HighlightBlockClient"
    ],
    "modmenu": [
      "community.wintercraft.highlightblock.gui.ModMenuIntegration"
    ]
  },
  "mixins": [
    "highlightblock.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=26.2",
    "fabric-api": "*"
  }
}
